	(text "The operating voltage of the LED\nmust match the selection here.\nSolder a bridge on either JP3 or\nJP4 to choose your operating voltage.\n\nWARNING: DO NOT SOLDER BOTH\nPADS OR DAMAGE WILL OCCUR\n\nJP3 = 5v\nJP4 = 3.3v"
		(exclude_from_sim no)
		(at 117.602 105.664 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "1943bc1f-cc05-45fb-843d-747c132330cd")
	)
	(text "1) This is a 2-Layer PCB\n2) Each layer requires a 2oz Copper pour\n3) The 12V_Supply and Vin(+12V) symbols under PWR FLAGS depict 2 different\n   nets, but are ultimately tied together.  "
		(exclude_from_sim no)
		(at 13.97 26.67 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "3e180b60-244b-4c6b-90ba-ec096048412a")
	)
	(text "Note:  All connectors associated with backlighting channels (BL#1 thru BL#10) are \n       Molex Mini-Fit Jr. 2x02 (Part Number: 39-28-1043)"
		(exclude_from_sim no)
		(at 98.425 20.32 0)
		(effects
