	(text "Channel 01 = 22 (Port J-12)\nChannel 02 = 4  (Port J-7)\nChannel 03 = 25 (Port J-0)\nChannel 04 = 27 (Port J-1)\nChannel 05 = 29 (Port J-2)\nChannel 06 = 31 (Port J3)\nChannel 07 = 33 (Port J4)\nChannel 08 = 35 (Port J5)\nChannel 09 = 37 (Port J6)\nChannel 10 = 38 (Port J7)\n\nTemp Led = 39\n\nRS485 RX = 0\nRS485 TX = 1\n\nFan 1 PWM = 32 (Port K-4)\nFan 2 PWM = 30 (Port K-3)\n\nFan 1 Tach = 5\nFan 2 Tach = 3\n\nTemp Sensor = SDA, SCL\n"
		(exclude_from_sim no)
		(at -273.05 -30.48 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
