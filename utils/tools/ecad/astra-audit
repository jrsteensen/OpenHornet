#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
"$script_dir/preflight" audit

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

model="${OH_ASTRA_MODEL:-gpt-6-astra}"
echo
echo "Launching OpenHornet Astra Audit mode: model=$model, approval=never, sandbox=read-only"
exec codex -m "$model" -a never -s read-only "$@"
